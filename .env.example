# Canonical origin and optional subpath. Do not add a trailing slash.
# Leave empty to use site.config.json; override after a custom domain is connected.
SITE_URL=

# Optional Google services. Keep empty when not configured.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# TODO(AdSense): Set only after a Publisher ID is issued.
VITE_ADSENSE_PUBLISHER_ID=
